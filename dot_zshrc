typeset -U path fpath  # drop duplicate PATH entries
fpath=(~/.zsh/completions $fpath)
# full check + dump rebuild once a day, else trust the cached dump (~18ms less);
# rm ~/.zcompdump to pick up new completions sooner
autoload -Uz compinit
() { if (( $# )); then compinit && touch ~/.zcompdump; else compinit -C; fi } ~/.zcompdump(N.mh+24)
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# vi line editing (explicit, rather than implied by EDITOR=nvim);
# Ghostty's shell integration already switches block/bar cursor per mode
bindkey -v
KEYTIMEOUT=1  # Esc → normal mode in 10ms, not 400ms

# insert mode: deletes/jumps that don't stop at the insert point
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^[^?' backward-kill-word  # Option+Backspace
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line

# normal mode Ctrl+V: edit the line in nvim, :wq runs it
autoload -Uz edit-command-line && zle -N edit-command-line
bindkey -M vicmd '^V' edit-command-line

# ci" ca' di( da{ yib ... like vim text objects
autoload -Uz select-quoted select-bracketed
zle -N select-quoted && zle -N select-bracketed
for m in viopp visual; do
  for c in {a,i}${(s..)^:-\'\"\`}; do bindkey -M $m $c select-quoted; done
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do bindkey -M $m $c select-bracketed; done
done

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(starship init zsh)"

___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi

# switches node on cd per .nvmrc/.node-version; no file = brew node ("system")
eval "$(fnm env --use-on-cd --version-file-strategy=recursive --log-level=quiet --shell zsh)"
unsetopt hash_cmds  # else zsh keeps brew's cached node path after fnm switches

export PYTHON=python3

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

eval "$(tv init zsh)"

. "$HOME/.atuin/bin/env"

eval "$(atuin init zsh)"

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

eval "$(zoxide init zsh)"

export EDITOR=nvim
export VISUAL=nvim

# pi-pretty / Shiki syntax highlighting theme
export PRETTY_THEME=nord

# pi-ask-user: use inline display mode by default
export PI_ASK_USER_DISPLAY_MODE=inline

# ppi: complete subcommands and profile IDs
eval "$(ppi completion zsh)"


# fzf defaults to its 256-colour "dark" scheme on a 256-colour terminal, which is
# built from fixed cube indices (109/161/236...) that no terminal theme controls.
# base16 confines it to ANSI 0-15, so it inherits Ghostty's Material Darker.
export FZF_DEFAULT_OPTS='--color=base16'

# must stay last: wraps every widget defined above
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

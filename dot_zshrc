typeset -U path fpath  # drop duplicate PATH entries
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(starship init zsh)"

___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi

# switches node on cd per .nvmrc/.node-version; no file = brew node ("system")
eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"
chpwd_functions+=(rehash)  # runs after fnm's hook; zsh caches brew's node path otherwise

export PYTHON=python3

# build/run amd64 images on Apple Silicon; unset to use native arm64 images
export DOCKER_DEFAULT_PLATFORM=linux/amd64

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

eval "$(tv init zsh)"

. "$HOME/.atuin/bin/env"

eval "$(atuin init zsh)"

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

eval "$(zoxide init zsh)"

export EDITOR=nvim
export VISUAL=nvim

# pi-pretty / Shiki syntax highlighting theme
export PRETTY_THEME=nord

# pi-ask-user: use inline display mode by default
export PI_ASK_USER_DISPLAY_MODE=inline

# Figma REST API token from macOS Keychain
export FIGMA_API_KEY="$(security find-generic-password -a "$USER" -s figma-api-key -w 2>/dev/null)"

# ppi: complete subcommands and profile IDs
eval "$(ppi completion zsh)"


# fzf defaults to its 256-colour "dark" scheme on a 256-colour terminal, which is
# built from fixed cube indices (109/161/236...) that no terminal theme controls.
# base16 confines it to ANSI 0-15, so it inherits Ghostty's Material Darker.
export FZF_DEFAULT_OPTS='--color=base16'

# must stay last: wraps every widget defined above
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

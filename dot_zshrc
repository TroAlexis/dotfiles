fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(starship init zsh)"

___MY_VMOPTIONS_SHELL_FILE="${HOME}/.jetbrains.vmoptions.sh"; if [ -f "${___MY_VMOPTIONS_SHELL_FILE}" ]; then . "${___MY_VMOPTIONS_SHELL_FILE}"; fi

export NVM_DIR="$HOME/.nvm"
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh" --no-use  # ponytail: skip nvm auto-use at startup; run `nvm use` per project

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

export PYTHON=python3

# useful only for Mac OS Silicon M1, 
# still working but useless for the other platforms
docker() {
 if [[ `uname -m` == "arm64" ]] && [[ "$1" == "run" || "$1" == "build" ]]; then
    /usr/local/bin/docker "$1" --platform linux/amd64 "${@:2}"
  else
     /usr/local/bin/docker "$@"
  fi
}
export PATH="/opt/homebrew/opt/e2fsprogs/bin:$PATH"
export PATH="/opt/homebrew/opt/e2fsprogs/sbin:$PATH"
export PATH="$PATH:$HOME/.local/bin"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end



# Added by Antigravity CLI installer

eval "$(tv init zsh)"

. "$HOME/.atuin/bin/env"

eval "$(atuin init zsh)"

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases

eval "$(zoxide init zsh)"

# AI Skills Channel for Television
# Quick access to explore AI agent skills from all locations
export EDITOR=nvim
export VISUAL=nvim

# pi-pretty / Shiki syntax highlighting theme
export PRETTY_THEME=nord

# pi-ask-user: use inline display mode by default
export PI_ASK_USER_DISPLAY_MODE=inline

# Figma REST API token from macOS Keychain
export FIGMA_API_KEY="$(security find-generic-password -a "$USER" -s figma-api-key -w 2>/dev/null)"

# ppi: complete subcommands and profile IDs
eval "$(ppi completion zsh)"


# fzf defaults to its 256-colour "dark" scheme on a 256-colour terminal, which is
# built from fixed cube indices (109/161/236...) that no terminal theme controls.
# base16 confines it to ANSI 0-15, so it inherits Ghostty's Material Darker.
export FZF_DEFAULT_OPTS='--color=base16'

# must stay last: wraps every widget defined above
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
